# Sticker API (apps/server). On a phone, use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8787
# Store links WhatsApp shows to people who receive one of your stickers.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# Web domain for universal links / App Links (no scheme), and the app id.
WEB_DOMAIN=stickers.example.com
APP_BUNDLE_ID=ai.stickers.app
# Public website (Terms, Privacy and pack links) and the support address.
EXPO_PUBLIC_SITE_URL=https://stickers.example.com
EXPO_PUBLIC_CONTACT_EMAIL=hello@stickers.example.com
# 1 shows the server address setting in a release build (test builds only).
EXPO_PUBLIC_DEV_SETTINGS=
