<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 11+ package visibility: lets us see whether WhatsApp is installed. -->
  <queries>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
  </queries>

  <application>
    <!-- WhatsApp reads pack metadata and sticker files through this provider.
         ${applicationId} is replaced with the app's id when the manifests are merged. -->
    <provider
      android:name="expo.modules.whatsappstickers.StickerContentProvider"
      android:authorities="${applicationId}.stickercontentprovider"
      android:enabled="true"
      android:exported="true"
      android:readPermission="com.whatsapp.sticker.READ" />
  </application>
</manifest>
