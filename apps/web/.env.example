# Sticker API (apps/server). Used by the browser and by server rendering.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Public address of this site, used for share cards and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Store links shown on pack pages. Leave empty until the apps are published.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Universal links / App Links so /p/<id> opens the mobile app when it is installed.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=ai.stickers.app
ANDROID_PACKAGE=ai.stickers.app
# Comma separated SHA-256 fingerprints of the Android signing certificate.
ANDROID_SHA256_CERT_FINGERPRINTS=
# Support and privacy contact shown on Help, Privacy and Delete your data.
NEXT_PUBLIC_CONTACT_EMAIL=hello@stickers.example.com
# Shown on the pricing page; keep it equal to the server's FREE_PACKS_PER_DAY.
NEXT_PUBLIC_FREE_PACKS_PER_DAY=2
# Imprint (Impressum), required for Germany and Austria.
IMPRINT_COMPANY=
IMPRINT_ADDRESS=
IMPRINT_REPRESENTATIVE=
IMPRINT_REGISTER=
IMPRINT_VAT_ID=
