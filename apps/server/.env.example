# Copy to .env (never commit .env). Every value is optional for local development.

# --- Image model (company AI gateway, OpenAI Images protocol) ---
# With no key the server falls back to the offline mock drawer.
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://ai-gateway.deepthink.works
# Set to 1 when a proxy injects the Authorization header for you.
GATEWAY_AUTH_INJECTED=
# gpt-image-2.6-flare (default) or gpt-image-2.5-flare.
IMAGE_MODEL=gpt-image-2.6-flare
IMAGE_QUALITY=medium
# gateway | mock. Leave empty to pick automatically.
IMAGE_PROVIDER=
GATEWAY_TIMEOUT_MS=240000

# --- HTTP ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
PUBLISHER_NAME=Stickers AI
MAX_ACTIVE_JOBS_PER_DEVICE=2

# --- Database: empty uses embedded PGlite under DATA_DIR ---
DATABASE_URL=
DATA_DIR=./data

# --- File storage: empty S3_BUCKET stores files under DATA_DIR/files ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Worker ---
RUN_WORKER=true
WORKER_JOB_CONCURRENCY=2
WORKER_STICKER_CONCURRENCY=3

# --- Limits ---
# Free packs each device may start per UTC day (failed packs don't count). 0 = no limit.
FREE_PACKS_PER_DAY=2
